{
  "manifest_version": 3,
  "name": "ClarityTV",
  "version": "2.0.0",
  "description": "Zero-interface spatial interaction model for elderly media consumption.",
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["shows.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
